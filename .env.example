# Claude API key (or leave unset if you've run `ant auth login`)
ANTHROPIC_API_KEY=

# Slack app credentials (see README "Slack setup")
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...

# Optional tuning
ZACKBOT_MODEL=claude-opus-5-5
ZACKBOT_EFFORT=medium
# Conversations reset after this many user turns (keeps cost + context sane)
ZACKBOT_MAX_TURNS=40
